# --------------------------------------------------
# Application
# --------------------------------------------------

APP_ENVIRONMENT=development

DEBUG=True

# --------------------------------------------------
# LLM
# --------------------------------------------------

DEFAULT_LLM_PROVIDER=openai

DEFAULT_LLM_MODEL=gpt-4.1

OPENAI_API_KEY=

# Request timeout in seconds, shared by every LLM provider.
#
# The variable is TIMEOUT, not OPENAI_TIMEOUT -- the settings class
# sets no env_prefix, so the field alias IS the variable name.
# OPENAI_TIMEOUT was documented here but never read by anything.
#
# It is only applied to providers when you set it explicitly; leave
# it unset and each provider keeps its own default (60s for the hosted
# APIs, 120s for the local Ollama provider). Set it when one setting
# should cover every provider -- raise it for the summarise/report
# pipeline, which sends the whole workspace corpus in one call.
#
# A provider-specific variable still wins: MINIMAX_TIMEOUT for
# MiniMax, OLLAMA_TIMEOUT for the local Ollama daemon.
TIMEOUT=60

OPENAI_MAX_RETRIES=3

# --- MiniMax (Anthropic-compatible /v1/messages) ---
# The MiniMax provider reads its own timeout from MINIMAX_TIMEOUT.
# It is separate from OPENAI_TIMEOUT because the OpenAI-compatible
# providers and MiniMax have very different request profiles:
# MiniMax-M3.1-Flash is a reasoning model (it emits a "thinking"
# block before the answer), so the generate pipeline -- which
# summarises the whole workspace corpus in one call -- routinely
# exceeds 60 seconds on a 20-paper corpus. Raise it.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_TIMEOUT=300

# --------------------------------------------------
# PubMed
# --------------------------------------------------

PUBMED_EMAIL=

PUBMED_API_KEY=

# --------------------------------------------------
# Logging
# --------------------------------------------------

LOG_LEVEL=INFO